<?xml version="1.0" encoding="utf-8"?>
<!-- Keypad friendly contact editor: one column, empty sections hidden, "Add field" and "Save" rows at the end.
     The original view ids are kept so the activity code keeps working. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contact_wrapper"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/contact_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/contact_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/normal_margin">

            <!-- header: OK on the photo changes it -->
            <ImageView
                android:id="@+id/contact_photo"
                android:layout_width="@dimen/dpad_contact_photo_size"
                android:layout_height="@dimen/dpad_contact_photo_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/normal_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:contentDescription="@string/change_photo"
                android:focusable="true"
                android:scaleType="centerCrop"
                tools:src="@drawable/ic_person_vector" />

            <ImageView
                android:id="@+id/contact_photo_bottom_shadow"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/contact_toggle_favorite"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:focusable="false"
                android:src="@drawable/ic_star_outline_vector"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/contact_change_photo"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:contentDescription="@null"
                android:focusable="false"
                android:visibility="gone" />

            <!-- names -->
            <LinearLayout
                android:id="@+id/dpad_edit_section_names"
                style="@style/DpadDetailSection">

                <ImageView
                    android:id="@+id/contact_name_image"
                    style="@style/DpadDetailSectionIcon"
                    android:src="@drawable/ic_person_vector" />

                <LinearLayout style="@style/DpadEditSectionHolder">

                    <org.fossify.commons.views.MyEditText
                        android:id="@+id/contact_prefix"
                        style="@style/DpadEditField"
                        android:hint="@string/prefix"
                        android:inputType="textCapWords" />

                    <org.fossify.commons.views.MyAutoCompleteTextView
                        android:id="@+id/contact_first_name"
                        style="@style/DpadEditField"
                        android:completionThreshold="2"
                        android:hint="@string/first_name"
                        android:inputType="textCapWords" />

                    <org.fossify.commons.views.MyAutoCompleteTextView
                        android:id="@+id/contact_middle_name"
                        style="@style/DpadEditField"
                        android:completionThreshold="2"
                        android:hint="@string/middle_name"
                        android:inputType="textCapWords" />

                    <org.fossify.commons.views.MyAutoCompleteTextView
                        android:id="@+id/contact_surname"
                        style="@style/DpadEditField"
                        android:completionThreshold="2"
                        android:hint="@string/surname"
                        android:inputType="textCapWords" />

                    <org.fossify.commons.views.MyEditText
                        android:id="@+id/contact_suffix"
                        style="@style/DpadEditField"
                        android:hint="@string/suffix"
                        android:inputType="textCapWords" />

                    <org.fossify.commons.views.MyEditText
                        android:id="@+id/contact_nickname"
                        style="@style/DpadEditField"
                        android:hint="@string/nickname"
                        android:inputType="textCapWords" />
                </LinearLayout>
            </LinearLayout>

            <!-- phone numbers -->
            <LinearLayout
                android:id="@+id/dpad_edit_section_numbers"
                style="@style/DpadDetailSection">

                <ImageView
                    android:id="@+id/contact_numbers_image"
                    style="@style/DpadDetailSectionIcon"
                    android:src="@drawable/ic_phone_vector" />

                <LinearLayout style="@style/DpadEditSectionHolder">

                    <LinearLayout
                        android:id="@+id/contact_numbers_holder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/item_edit_phone_number" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/contact_numbers_add_new"
                        style="@style/DpadEditAddNew" />
                </LinearLayout>
            </LinearLayout>

            <!-- emails -->
            <LinearLayout
                android:id="@+id/dpad_edit_section_emails"
                style="@style/DpadDetailSection">

                <ImageView
                    android:id="@+id/contact_emails_image"
                    style="@style/DpadDetailSectionIcon"
                    android:src="@drawable/ic_mail_vector" />

                <LinearLayout style="@style/DpadEditSectionHolder">

                    <LinearLayout
                        android:id="@+id/contact_emails_holder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/item_edit_email" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/contact_emails_add_new"
                        style="@style/DpadEditAddNew" />
                </LinearLayout>
            </LinearLayout>

            <!-- addresses -->
            <LinearLayout
                android:id="@+id/dpad_edit_section_addresses"
                style="@style/DpadDetailSection">

                <ImageView
                    android:id="@+id/contact_addresses_image"
                    style="@style/DpadDetailSectionIcon"
                    android:src="@drawable/ic_place_vector" />

                <LinearLayout style="@style/DpadEditSectionHolder">

                    <LinearLayout
                        android:id="@+id/contact_addresses_holder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <ImageView
                        android:id="@+id/contact_addresses_add_new"
                        style="@style/DpadEditAddNew" />
                </LinearLayout>
            </LinearLayout>

            <!-- instant messaging -->
            <LinearLayout
                android:id="@+id/dpad_edit_section_ims"
                style="@style/DpadDetailSection">

                <ImageView
                    android:id="@+id/contact_ims_image"
                    style="@style/DpadDetailSectionIcon"
                    android:src="@drawable/ic_im" />

                <LinearLayout style="@style/DpadEditSectionHolder">

                    <LinearLayout
                        android:id="@+id/contact_ims_holder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/item_edit_im" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/contact_ims_add_new"
                        style="@style/DpadEditAddNew" />
                </LinearLayout>
            </LinearLayout>

            <!-- events (birthday, anniversary…) -->
            <LinearLayout
                android:id="@+id/dpad_edit_section_events"
                style="@style/DpadDetailSection">

                <ImageView
                    android:id="@+id/contact_events_image"
                    style="@style/DpadDetailSectionIcon"
                    android:src="@drawable/ic_cake_vector" />

                <LinearLayout style="@style/DpadEditSectionHolder">

                    <LinearLayout
                        android:id="@+id/contact_events_holder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/item_event" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/contact_events_add_new"
                        style="@style/DpadEditAddNew" />
                </LinearLayout>
            </LinearLayout>

            <!-- notes -->
            <LinearLayout
                android:id="@+id/dpad_edit_section_notes"
                style="@style/DpadDetailSection">

                <ImageView
                    android:id="@+id/contact_notes_image"
                    style="@style/DpadDetailSectionIcon"
                    android:src="@drawable/ic_label_vector" />

                <LinearLayout style="@style/DpadEditSectionHolder">

                    <org.fossify.commons.views.MyEditText
                        android:id="@+id/contact_notes"
                        style="@style/DpadEditField"
                        android:hint="@string/notes"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="6"
                        android:singleLine="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- ringtone -->
            <LinearLayout
                android:id="@+id/dpad_edit_section_ringtone"
                style="@style/DpadDetailSection">

                <ImageView
                    android:id="@+id/contact_ringtone_image"
                    style="@style/DpadDetailSectionIcon"
                    android:src="@drawable/ic_bell_vector" />

                <LinearLayout style="@style/DpadEditSectionHolder">

                    <org.fossify.commons.views.MyTextView
                        android:id="@+id/contact_ringtone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/dpad_detail_section_icon_height"
                        android:paddingStart="@dimen/small_margin"
                        android:textSize="@dimen/bigger_text_size" />
                </LinearLayout>
            </LinearLayout>

            <!-- organization -->
            <LinearLayout
                android:id="@+id/dpad_edit_section_organization"
                style="@style/DpadDetailSection">

                <ImageView
                    android:id="@+id/contact_organization_image"
                    style="@style/DpadDetailSectionIcon"
                    android:src="@drawable/ic_business_vector" />

                <LinearLayout style="@style/DpadEditSectionHolder">

                    <org.fossify.commons.views.MyEditText
                        android:id="@+id/contact_organization_company"
                        style="@style/DpadEditField"
                        android:hint="@string/company"
                        android:inputType="textCapWords" />

                    <org.fossify.commons.views.MyEditText
                        android:id="@+id/contact_organization_job_position"
                        style="@style/DpadEditField"
                        android:hint="@string/job_position"
                        android:inputType="textCapWords" />
                </LinearLayout>
            </LinearLayout>

            <!-- websites -->
            <LinearLayout
                android:id="@+id/dpad_edit_section_websites"
                style="@style/DpadDetailSection">

                <ImageView
                    android:id="@+id/contact_websites_image"
                    style="@style/DpadDetailSectionIcon"
                    android:src="@drawable/ic_link_vector" />

                <LinearLayout style="@style/DpadEditSectionHolder">

                    <LinearLayout
                        android:id="@+id/contact_websites_holder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/item_edit_website" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/contact_websites_add_new"
                        style="@style/DpadEditAddNew" />
                </LinearLayout>
            </LinearLayout>

            <!-- groups -->
            <LinearLayout
                android:id="@+id/dpad_edit_section_groups"
                style="@style/DpadDetailSection">

                <ImageView
                    android:id="@+id/contact_groups_image"
                    style="@style/DpadDetailSectionIcon"
                    android:src="@drawable/ic_people_vector" />

                <LinearLayout style="@style/DpadEditSectionHolder">

                    <LinearLayout
                        android:id="@+id/contact_groups_holder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include layout="@layout/item_edit_group" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/contact_groups_add_new"
                        style="@style/DpadEditAddNew" />
                </LinearLayout>
            </LinearLayout>

            <!-- add another field (email, address, birthday…) -->
            <LinearLayout
                android:id="@+id/dpad_edit_row_add_field"
                style="@style/DpadDetailRow">

                <ImageView
                    android:id="@+id/dpad_edit_add_field_icon"
                    style="@style/DpadDetailRowIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_plus_vector" />

                <org.fossify.commons.views.MyTextView
                    style="@style/DpadDetailRowText"
                    android:text="@string/dpad_add_field" />
            </LinearLayout>

            <!-- account the contact is saved to, OK picks another one -->
            <LinearLayout
                android:id="@+id/dpad_edit_section_source"
                style="@style/DpadDetailSection">

                <ImageView
                    android:id="@+id/contact_source_image"
                    style="@style/DpadDetailSectionIcon"
                    android:src="@drawable/ic_save_vector" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/contact_source"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:minHeight="@dimen/dpad_detail_section_icon_height"
                    android:paddingStart="@dimen/small_margin"
                    android:paddingEnd="@dimen/normal_margin"
                    android:singleLine="true"
                    android:textSize="@dimen/bigger_text_size"
                    tools:text="DEVICE" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/normal_margin"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginEnd="@dimen/normal_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:background="#33808080" />

            <!-- leaving the editor: Back is used by the keyboard to delete text while typing -->
            <LinearLayout
                android:id="@+id/dpad_edit_row_cancel"
                style="@style/DpadDetailRow">

                <ImageView
                    android:id="@+id/dpad_edit_cancel_icon"
                    style="@style/DpadDetailRowIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cross_vector" />

                <org.fossify.commons.views.MyTextView
                    style="@style/DpadDetailRowText"
                    android:text="@string/cancel" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dpad_edit_row_save"
                style="@style/DpadDetailRow">

                <ImageView
                    android:id="@+id/dpad_edit_save_icon"
                    style="@style/DpadDetailRowIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_vector" />

                <org.fossify.commons.views.MyTextView
                    style="@style/DpadDetailRowText"
                    android:text="@string/save" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/contact_photo_top_shadow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- hidden, its menu items are reused by the Save row and the Menu key -->
    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/contact_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/contact_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_edit_contact" />

    </org.fossify.commons.views.MyAppBarLayout>
</RelativeLayout>
